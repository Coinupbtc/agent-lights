{
  "hooks": {
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "PreToolUse":         [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "PostToolUse":        [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "Notification":       [{ "matcher": "permission_prompt", "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "StopCancelled":      [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "python3 __REPO__/host/status_hook.py --agent grok 2>/dev/null || true", "timeout": 3 }] }]
  }
}
